// Cloudflare Workers: the built site as static assets, plus the MCP endpoint
// at /mcp from src/mcp/worker.ts, which also sends broadside.tech and www to the
// observer. `npm run deploy` builds, stages the cards
// next to the site, and uploads. Everything but /mcp is served as a file,
// falling back to index.html the way nginx's try_files does.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "broadside-observer",
  "main": "src/mcp/worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "observer.anoptic.io", "custom_domain": true },
    { "pattern": "observer.broadside.tech", "custom_domain": true },
    { "pattern": "broadside.tech", "custom_domain": true },
    { "pattern": "www.broadside.tech", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
