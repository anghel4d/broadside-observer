# Whitelist gitignore: everything is ignored unless named below.
# To track something new, name it here.
*

# Repository metadata and project description.
!/.gitignore
!/README.md

# Declarative Nix interface.
!/flake.nix
!/flake.lock

# Human-readable research summaries only.
!/summaries/
!/summaries/**/
!/summaries/*.md
!/summaries/**/*.md

# Complete plain-text sources whose licenses permit republication.
!/sources/
!/sources/02-model-or-harness.txt
!/sources/05-zero-mem.txt

# Declarative radar scope and durable run state.
!/radar/
!/radar/**/
!/radar/*.yaml
!/radar/*.json
!/radar/*.md
!/radar/runs/.gitkeep
!/radar/runs/*.md

# Seed digests from historical prefill.
!/seeds/
!/seeds/**
/seeds/app/node_modules/
/seeds/app/dist/
/seeds/app/src/generated/cards.json
